# DEE BAKES - Environment Configuration Template

# Supabase PostgreSQL & Storage configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only service role key (Never expose in frontend code)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional Custom Application URL
NEXT_PUBLIC_SITE_URL=https://deebakes.ng
